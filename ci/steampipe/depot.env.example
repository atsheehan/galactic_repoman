# Copy to ci/steampipe/depot.env (gitignored) and fill in real values for the
# local testing flow. These are NON-SECRET config. CI does not use this file —
# it supplies APPID/DEPOTID from repo variables and SETLIVE from the workflow input.
#
# direnv users: a gitignored .envrc containing `dotenv ci/steampipe/depot.env`
# loads these on `cd`; package.sh reads the environment when depot.env is absent.
APPID=
DEPOTID=
SETLIVE=internal
